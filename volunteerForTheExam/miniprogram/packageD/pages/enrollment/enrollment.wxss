.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.score-input-box {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.score-input {
  width: 100%;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.recommend-btn {
  width: 100%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.paths-list {
  margin-bottom: 30rpx;
}

.path-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border-left: 6rpx solid #4facfe;
}

.path-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.path-name-box {
  flex: 1;
}

.path-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.path-type {
  display: inline-block;
  font-size: 22rpx;
  color: #4facfe;
  background-color: rgba(79, 172, 254, 0.1);
  padding: 6rpx 15rpx;
  border-radius: 15rpx;
}

.match-score {
  text-align: center;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 12rpx;
  padding: 15rpx 20rpx;
  min-width: 120rpx;
}

.score-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.score-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.path-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.path-info {
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 15rpx;
  background-color: rgba(76, 175, 80, 0.05);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.info-item.warning {
  background-color: rgba(255, 152, 0, 0.05);
}

.info-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
  color: #4caf50;
}

.info-item.warning .info-icon {
  color: #ff9800;
}

.info-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.suitable-tag {
  display: flex;
  align-items: center;
  padding: 15rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tag-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.tag-text {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}

.view-detail-btn {
  text-align: center;
  padding: 15rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 50rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 85%;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  flex-shrink: 0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.close-btn {
  font-size: 40rpx;
  color: #fff;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: scroll;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.section-content {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.section-content.advantage {
  color: #4caf50;
  background-color: rgba(76, 175, 80, 0.05);
  padding: 15rpx;
  border-radius: 12rpx;
}

.section-content.warning {
  color: #ff9800;
  background-color: rgba(255, 152, 0, 0.05);
  padding: 15rpx;
  border-radius: 12rpx;
}

.universities-list,
.majors-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.university-tag,
.major-tag {
  font-size: 24rpx;
  color: #4facfe;
  background-color: rgba(79, 172, 254, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(79, 172, 254, 0.2);
}

.timeline {
  margin-top: 15rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 25rpx;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 30rpx;
  bottom: -25rpx;
  width: 2rpx;
  background-color: #e0e0e0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 5rpx;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-content {
  flex: 1;
}

.timeline-month {
  display: inline-block;
  font-size: 24rpx;
  color: #4facfe;
  background-color: rgba(79, 172, 254, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
  font-weight: bold;
}

.timeline-event {
  font-size: 26rpx;
  color: #333;
}
