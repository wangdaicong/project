.header-banner {
  background: linear-gradient(135deg, #667EEA 0%, #4A90E2 100%);
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 20rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.search-bar {
  margin-bottom: 30rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin: 30rpx 0 20rpx;
}

.hot-careers {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.career-card {
  position: relative;
}

.career-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.career-position {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
}

.demand-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.career-industry {
  font-size: 24rpx;
  color: #7F8C8D;
  margin-bottom: 12rpx;
}

.career-salary {
  font-size: 28rpx;
  color: #27AE60;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.career-trend {
  font-size: 24rpx;
  color: #5A6C7D;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.trend-label {
  font-weight: 600;
}

.trend-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.career-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8ECF0;
}

.demand-text {
  font-size: 22rpx;
  color: #7F8C8D;
  width: 120rpx;
}

.demand-bar {
  flex: 1;
  height: 12rpx;
  background: #E8ECF0;
  border-radius: 6rpx;
  overflow: hidden;
}

.demand-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.demand-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #2C3E50;
  width: 60rpx;
  text-align: right;
}

.industry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.industry-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.industry-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.industry-name {
  font-size: 26rpx;
  color: #2C3E50;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.industry-count {
  font-size: 22rpx;
  color: #7F8C8D;
}

.career-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.career-list-item {
  padding: 30rpx;
}

.list-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.position-info {
  flex: 1;
}

.position-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.position-industry {
  font-size: 22rpx;
  color: #4A90E2;
}

.salary-tag {
  background: #E8F8F5;
  color: #27AE60;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.position-desc {
  font-size: 26rpx;
  color: #5A6C7D;
  line-height: 1.6;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.position-meta {
  display: flex;
  gap: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #E8ECF0;
}

.meta-tag {
  font-size: 22rpx;
  color: #7F8C8D;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #7F8C8D;
}

/* Tab切换样式 */
.tabs {
  display: flex;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab.active {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  font-weight: bold;
}

/* 专业就业Tab样式 */
.major-info-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.major-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.major-category {
  font-size: 26rpx;
  color: #999;
}

.data-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.data-card {
  flex: 1;
  min-width: calc(50% - 10rpx);
  background-color: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #4facfe;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 24rpx;
  color: #999;
}

.employment-detail .section {
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.industry-distribution {
  padding: 20rpx 0;
}

.industry-distribution .industry-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.industry-distribution .industry-name {
  width: 120rpx;
  font-size: 26rpx;
  color: #333;
}

.industry-bar {
  flex: 1;
  height: 30rpx;
  background-color: #f0f0f0;
  border-radius: 15rpx;
  overflow: hidden;
  margin: 0 15rpx;
}

.industry-fill {
  height: 100%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 15rpx;
  transition: width 0.3s;
}

.industry-percentage {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #666;
}

.career-item {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.career-item .career-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.career-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.match-degree {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: bold;
}

.career-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.skill-tag {
  padding: 6rpx 12rpx;
  background-color: rgba(79, 172, 254, 0.1);
  color: #4facfe;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.jobs-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.job-tag {
  padding: 10rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.hot-majors {
  margin-top: 30rpx;
}

.major-scroll {
  white-space: nowrap;
  padding: 10rpx 0;
}

.major-card {
  display: inline-block;
  width: 200rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-right: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  vertical-align: top;
}

.major-card-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  white-space: normal;
}

.major-card-salary {
  display: block;
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.major-card-rate {
  display: block;
  font-size: 22rpx;
  color: #52c41a;
}

.search-btn {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 15rpx 35rpx;
  font-size: 28rpx;
  border: none;
  margin-left: 15rpx;
}
