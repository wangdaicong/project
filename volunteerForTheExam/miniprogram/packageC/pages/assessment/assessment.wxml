<view class="container">
  <!-- 顶部进度 -->
  <view class="progress-bar">
    <view class="progress-info">
      <text class="category-tag">{{currentCategory}}</text>
      <text class="progress-text">{{currentIndex + 1}}/{{totalQuestions}}</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 问题区域 -->
  <view class="question-area" wx:if="{{!loading && questions.length > 0}}">
    <view class="question-card">
      <view class="question-number">问题 {{currentIndex + 1}}</view>
      <view class="question-text">{{questions[currentIndex].question}}</view>
    </view>

    <!-- 选项列表 -->
    <view class="options-list">
      <view 
        class="option-item {{getCurrentAnswer() === option.id ? 'selected' : ''}}"
        wx:for="{{questions[currentIndex].options}}" 
        wx:key="id"
        bindtap="selectOption"
        data-id="{{option.id}}">
        <view class="option-radio">
          <view class="radio-dot" wx:if="{{getCurrentAnswer() === option.id}}"></view>
        </view>
        <view class="option-text">{{option.text}}</view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions" wx:if="{{!loading}}">
    <button 
      class="btn-secondary" 
      bindtap="prevQuestion"
      disabled="{{currentIndex === 0}}">
      上一题
    </button>
    <button 
      class="btn-primary" 
      bindtap="nextQuestion"
      disabled="{{!getCurrentAnswer()}}">
      {{currentIndex === totalQuestions - 1 ? '完成测评' : '下一题'}}
    </button>
  </view>

  <!-- 提示 -->
  <view class="tips" wx:if="{{!loading}}">
    <text>💡 请根据真实情况选择，以获得更准确的推荐</text>
  </view>
</view>
