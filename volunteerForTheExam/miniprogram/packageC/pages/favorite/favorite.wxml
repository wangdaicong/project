<view class="container">
  <view class="header-banner">
    <view class="banner-title">⭐ 我的收藏</view>
    <view class="banner-desc">收藏的院校 {{favorites.length}} 所</view>
    <view class="clear-btn" bindtap="clearAll" wx:if="{{!isEmpty}}">清空</view>
  </view>

  <view class="favorite-list" wx:if="{{!isEmpty}}">
    <view class="favorite-item card" wx:for="{{favorites}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="item-header">
        <view class="item-logo">🎓</view>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="item-meta">
            <text class="meta-item">📍 {{item.province}}</text>
            <text class="meta-item level">{{item.level}}</text>
          </view>
        </view>
      </view>
      
      <view class="item-stats">
        <view class="stat-item" wx:if="{{item.ranking}}">
          <text class="stat-value">{{item.ranking}}</text>
          <text class="stat-label">排名</text>
        </view>
        <view class="stat-item" wx:if="{{item.minScore}}">
          <text class="stat-value">{{item.minScore}}</text>
          <text class="stat-label">最低分</text>
        </view>
      </view>

      <view class="item-actions">
        <button class="action-btn" catchtap="addToCompare" data-id="{{item.id}}">
          <text class="btn-icon">📊</text>
          <text>加入对比</text>
        </button>
        <button class="action-btn remove" catchtap="removeFavorite" data-id="{{item.id}}">
          <text class="btn-icon">🗑️</text>
          <text>取消收藏</text>
        </button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-icon">⭐</view>
    <view class="empty-title">暂无收藏</view>
    <view class="empty-desc">快去收藏心仪的院校吧</view>
    <button class="btn-primary" bindtap="goToSearch">去查找院校</button>
  </view>
</view>
