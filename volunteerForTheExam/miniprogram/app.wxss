page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  height: 100%;
}

view {
  box-sizing: border-box;
}

text {
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: #34495E;
  margin-bottom: 15rpx;
}

.text {
  font-size: 26rpx;
  color: #5A6C7D;
  line-height: 1.6;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #E8F4FD;
  color: #4A90E2;
  border-radius: 30rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-success {
  background: #E8F8F5;
  color: #27AE60;
}

.tag-warning {
  background: #FEF5E7;
  color: #F39C12;
}

.tag-danger {
  background: #FADBD8;
  color: #E74C3C;
}

.btn-primary {
  background: linear-gradient(135deg, #667EEA 0%, #4A90E2 100%);
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

.btn-secondary {
  background: #FFFFFF;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.divider {
  height: 1rpx;
  background: #E8ECF0;
  margin: 30rpx 0;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #E74C3C;
  color: #FFFFFF;
  border-radius: 50%;
  width: 36rpx;
  height: 36rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
