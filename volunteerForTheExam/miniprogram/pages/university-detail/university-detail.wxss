.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.university-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.header-info {
  flex: 1;
}

.university-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.tags {
  display: flex;
  margin-bottom: 10rpx;
}

.tag {
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
  font-size: 20rpx;
  border-radius: 4rpx;
  color: #fff;
}

.tag-985 {
  background-color: #ff6b35;
}

.tag-211 {
  background-color: #4ecdc4;
}

.tag-double {
  background-color: #95e1d3;
}

.location {
  font-size: 24rpx;
  color: #999;
}

.collect-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: #fff;
  border: 2rpx solid #ff6b35;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ff6b35;
  line-height: 60rpx;
}

.collect-btn text.collected {
  color: #fff;
  background-color: #ff6b35;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* Tab导航 */
.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #ff6b35;
  border-radius: 2rpx;
}

/* 内容区域 */
.content {
  flex: 1;
  padding: 20rpx;
}

.section {
  margin-bottom: 20rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #ff6b35;
}

/* 院校简介 */
.intro-icons {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.intro-icon {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.intro-icon .icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.intro-icon .label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.intro-icon .value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.intro-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
}

.intro-text .ellipsis {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.intro-text .full {
  display: block;
}

.more-btn {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ff6b35;
}

/* 特色专业 */
.featured-majors {
  display: flex;
  flex-wrap: wrap;
}

.major-tag {
  padding: 10rpx 20rpx;
  margin: 10rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  color: #fff;
}

.major-tag.national {
  background-color: #ff6b35;
}

.major-tag.provincial {
  background-color: #4ecdc4;
}

/* 联系方式 */
.contact-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item .label {
  width: 180rpx;
  color: #999;
}

.contact-item .value {
  flex: 1;
  color: #333;
}

.contact-item .link {
  color: #ff6b35;
}

/* 招生简章 */
.brochure-list, .report-list {
  display: flex;
  flex-direction: column;
}

.brochure-item, .report-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.brochure-item:last-child, .report-item:last-child {
  border-bottom: none;
}

.brochure-item .title, .report-item .title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.brochure-item .date, .report-item .year {
  font-size: 24rpx;
  color: #999;
}

/* 院系设置 */
.department-list {
  display: flex;
  flex-direction: column;
}

.department-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.department-item:last-child {
  border-bottom: none;
}

.department-item .name {
  font-size: 28rpx;
  color: #333;
}

.department-item .count {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

/* 学科筛选 */
.category-filter {
  background-color: #fff;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.category-item.active {
  background-color: #ff6b35;
  color: #fff;
}

/* 专业统计 */
.major-stats {
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* 专业列表 */
.major-list {
  display: flex;
  flex-direction: column;
}

.major-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.major-item:last-child {
  border-bottom: none;
}

.major-info {
  flex: 1;
}

.major-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.major-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.meta-item {
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.major-meta .separator {
  margin: 0 10rpx;
}

.major-badge {
  padding: 8rpx 16rpx;
  background-color: #ff6b35;
  border-radius: 8rpx;
  margin-left: 20rpx;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}
