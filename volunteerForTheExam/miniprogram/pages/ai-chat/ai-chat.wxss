/* pages/ai-chat/ai-chat.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 顶部工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.toolbar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.toolbar-actions {
  display: flex;
  gap: 20rpx;
}

.toolbar-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

/* 上下文面板 */
.context-panel {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.context-header {
  margin-bottom: 20rpx;
}

.context-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.context-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.context-form {
  margin-top: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  width: 150rpx;
  font-size: 28rpx;
  color: #666;
}

.form-input,
.form-picker {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 10rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.message-avatar image {
  width: 100%;
  height: 100%;
}

.message-content {
  max-width: 70%;
  margin: 0 20rpx;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
  text-align: center;
}

.message-bubble {
  padding: 20rpx 25rpx;
  border-radius: 15rpx;
  position: relative;
}

.message-bubble.ai {
  background: #fff;
  border-top-left-radius: 0;
}

.message-bubble.user {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-top-right-radius: 0;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.message-bubble.ai .message-text {
  color: #333;
}

.message-bubble.user .message-text {
  color: #fff;
}

/* 加载动画 */
.loading {
  display: flex;
  gap: 10rpx;
  padding: 10rpx 0;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #999;
  animation: loading 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes loading {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 常见问题 */
.common-questions {
  background: #fff;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}

.questions-title {
  font-size: 28rpx;
  color: #666;
  padding: 0 30rpx 15rpx;
}

.questions-list {
  white-space: nowrap;
  padding: 0 30rpx;
}

.question-item {
  display: inline-block;
  padding: 15rpx 25rpx;
  margin-right: 15rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

/* 输入框 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.input-field {
  flex: 1;
  padding: 20rpx 25rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  border: none;
}

.send-btn::after {
  border: none;
}
