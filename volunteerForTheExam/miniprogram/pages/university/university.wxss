.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  display: flex;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding: 15rpx;
}

.search-btn {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 15rpx 35rpx;
  font-size: 28rpx;
  border: none;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-label {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

.filter-toggle {
  padding: 10rpx;
}

.arrow {
  font-size: 24rpx;
  color: #ff6b6b;
}

/* 底部弹窗遮罩 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

/* 底部弹窗 */
.popup-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1000;
}

.popup-sheet.show {
  transform: translateY(0);
}

/* 弹窗头部 */
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #eee;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

/* 弹窗内容 */
.popup-content {
  padding: 0;
  max-height: 60vh;
  overflow-y: auto;
}

.popup-option {
  padding: 32rpx 40rpx;
  background-color: #fff;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
  display: block;
  width: 100%;
}

.popup-option:last-child {
  border-bottom: none;
}

.popup-option.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: bold;
  font-size: 32rpx;
}

.filter-panel {
  background-color: #fff;
  padding: 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-category {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-category:last-of-type {
  border-bottom: none;
}

.category-label {
  font-size: 28rpx;
  color: #333;
}

.category-value {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.category-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}

.reset-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section:last-of-type {
  margin-bottom: 0;
}

.filter-label {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
  display: block;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-option.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: bold;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.filter-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  font-weight: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.reset-btn {
  background-color: #f0f0f0;
  color: #666;
}

.query-btn {
  background-color: #4A90E2;
  color: #fff;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0 20rpx 0;
}

.category-tabs {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  gap: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab {
  flex-shrink: 0;
  padding: 15rpx 25rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  font-weight: bold;
}

.network-tip {
  background: linear-gradient(135deg, #FFF4E6 0%, #FFE8CC 100%);
  border-left: 4rpx solid #FF9800;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #E65100;
  flex: 1;
}

.university-list {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
}

.university-card {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.university-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  align-items: flex-start;
}

.university-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
  border: 2rpx solid #eee;
}

.header-info {
  flex: 1;
}

.university-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.university-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #666;
  flex-wrap: wrap;
}

.meta-location {
  color: #E91E63;
}

.meta-divider {
  margin: 0 8rpx;
  color: #D0D0D0;
}

.meta-supervisor {
  color: #7F8C8D;
}

.university-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.level-tag {
  background: #E3F2FD;
  color: #2196F3;
}

.nature-tag {
  background: #F3E5F5;
  color: #9C27B0;
}

.special-tag {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.card-rating {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 12rpx;
}

.rating-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #f59e0b;
  line-height: 1;
}

.rating-stars {
  font-size: 16rpx;
  margin-top: 4rpx;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #f8f9fa;
  border-top: 1rpx solid #f0f0f0;
}

.footer-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.footer-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #3b82f6;
  line-height: 1;
}

.footer-value.score {
  color: #10b981;
}

.footer-label {
  font-size: 22rpx;
  color: #999;
}

.university-description {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
  padding: 15rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
}

/* 卡片主体 */
.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.info-label {
  color: #999;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  flex: 1;
}

.intro-row {
  display: block;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-text {
  color: #666;
  line-height: 1.6;
}

.intro-text {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.probability-rush {
  color: #ff6b6b;
  font-weight: bold;
}

.probability-stable {
  color: #52c41a;
  font-weight: bold;
}

.probability-safe {
  color: #1890ff;
  font-weight: bold;
}

/* 加载更多 */
.load-more {
  padding: 20rpx;
  text-align: center;
}

.load-more-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

.reset-filter-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}
