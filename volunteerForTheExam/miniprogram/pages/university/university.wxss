.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  display: flex;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding: 15rpx;
}

.search-btn {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 15rpx 35rpx;
  font-size: 28rpx;
  border: none;
}

.filter-bar {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

.filter-panel {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #666;
  font-weight: normal;
  text-align: center;
}

.picker {
  padding: 14rpx 12rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  color: #333;
  font-size: 26rpx;
  text-align: center;
  border: 1rpx solid #e8e8e8;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.filter-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  font-weight: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.reset-btn {
  background-color: #f0f0f0;
  color: #666;
}

.query-btn {
  background-color: #4A90E2;
  color: #fff;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0 20rpx 0;
}

.category-tabs {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  gap: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab {
  flex-shrink: 0;
  padding: 15rpx 25rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  font-weight: bold;
}

.network-tip {
  background: linear-gradient(135deg, #FFF4E6 0%, #FFE8CC 100%);
  border-left: 4rpx solid #FF9800;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #E65100;
  flex: 1;
}

.university-list {
  margin-bottom: 30rpx;
}

.university-card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
}

.university-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid #f0f0f0;
  min-width: 140rpx;
}

.university-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.university-name-section {
  flex: 1;
}

.university-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.university-level {
  font-size: 22rpx;
  color: #4facfe;
  background: linear-gradient(135deg, rgba(79, 172, 254, 0.1) 0%, rgba(0, 242, 254, 0.1) 100%);
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
}

.university-ranking {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ranking-value {
  font-size: 48rpx;
  color: #1890ff;
  font-weight: bold;
  line-height: 1;
}

.ranking-label {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
}

.score-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding-top: 12rpx;
}

.score-value {
  font-size: 40rpx;
  color: #52c41a;
  font-weight: bold;
  line-height: 1;
}

.score-label {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
}

.university-description {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
  padding: 15rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
}

.university-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.info-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

.info-text {
  color: #666;
  flex: 1;
}

.intro-text {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.probability-rush {
  color: #ff6b6b;
  font-weight: bold;
}

.probability-stable {
  color: #52c41a;
  font-weight: bold;
}

.probability-safe {
  color: #1890ff;
  font-weight: bold;
}

.plan-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  margin-bottom: 30rpx;
}

.plan-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.plan-content {
  flex: 1;
}

.plan-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.plan-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
}

.plan-arrow {
  font-size: 36rpx;
  color: #fff;
}
