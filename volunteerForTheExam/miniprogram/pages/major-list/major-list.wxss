.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* Tab切换 */
.degree-tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.degree-tab {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.degree-tab.active {
  color: #ff6b35;
  font-weight: bold;
}

.degree-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #ff6b35;
  border-radius: 2rpx;
}

/* 专业测评入口 */
.test-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  margin: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: #fff;
}

.test-title {
  font-size: 32rpx;
  font-weight: bold;
}

.test-btn {
  padding: 10rpx 30rpx;
  background-color: #fff;
  color: #667eea;
  font-size: 24rpx;
  border-radius: 30rpx;
}

/* 学科门类筛选 */
.category-tabs {
  display: flex;
  white-space: nowrap;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.category-tab {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.category-tab.active {
  background-color: #ff6b35;
  color: #fff;
}

/* 左右分栏 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧专业大类 */
.left-panel {
  width: 200rpx;
  background-color: #f5f5f5;
}

.sub-category-item {
  padding: 30rpx 20rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.sub-category-item.active {
  background-color: #fff;
  color: #ff6b35;
  font-weight: bold;
  border-left: 6rpx solid #ff6b35;
}

/* 右侧专业列表 */
.right-panel {
  flex: 1;
  background-color: #fff;
}

.major-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.major-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 加载状态 */
.loading, .no-more, .empty {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
