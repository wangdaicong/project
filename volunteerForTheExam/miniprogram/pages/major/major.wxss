.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  display: flex;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding: 15rpx;
}

.search-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 15rpx 35rpx;
  font-size: 28rpx;
  border: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0 20rpx 0;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 15rpx 30rpx;
  background-color: #fff;
  border-radius: 40rpx;
  margin-right: 15rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.category-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: bold;
}

.major-list {
  margin-bottom: 30rpx;
}

.major-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.major-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.major-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.major-category {
  padding: 6rpx 15rpx;
  background-color: rgba(102, 126, 234, 0.1);
  color: #667eea;
  border-radius: 15rpx;
  font-size: 22rpx;
}

.major-info {
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.info-label {
  color: #999;
  margin-right: 10rpx;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.info-value.highlight {
  color: #52c41a;
  font-weight: bold;
}

.info-value.salary {
  color: #ff6b6b;
  font-weight: bold;
}

.major-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 15rpx;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tool-cards {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.tool-card {
  flex: 1;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tool-icon {
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

.tool-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #999;
}
