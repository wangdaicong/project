.major-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.major-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 20rpx;
}

.major-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  font-size: 48rpx;
}

.stat-info {
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A90E2;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #7F8C8D;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #5A6C7D;
  line-height: 1.8;
  text-align: justify;
}

.career-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.career-item {
  background: linear-gradient(135deg, #F8F9FA 0%, #E8F4FD 100%);
  padding: 24rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #4A90E2;
}

.career-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.career-position {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
}

.career-industry {
  font-size: 22rpx;
  color: #4A90E2;
  background: #FFFFFF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.career-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #7F8C8D;
}

.career-salary {
  color: #27AE60;
  font-weight: 600;
}

.career-demand {
  color: #E67E22;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #7F8C8D;
}
