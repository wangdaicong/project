.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding: 10rpx;
}

.search-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 10rpx 30rpx;
  font-size: 28rpx;
}

.employment-detail {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.major-info {
  text-align: center;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.major-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.major-category {
  display: inline-block;
  font-size: 24rpx;
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.data-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.data-card {
  width: 48%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.card-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.card-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.title-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
}

.industry-distribution {
  padding: 20rpx 0;
}

.industry-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.industry-name {
  width: 120rpx;
  font-size: 26rpx;
  color: #333;
}

.industry-bar {
  flex: 1;
  height: 30rpx;
  background-color: #f0f0f0;
  border-radius: 15rpx;
  overflow: hidden;
  margin: 0 15rpx;
}

.industry-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 15rpx;
  transition: width 0.3s;
}

.industry-percentage {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #667eea;
  font-weight: bold;
}

.career-list {
  margin-top: 20rpx;
}

.career-item {
  background-color: #f8f9fa;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #667eea;
}

.career-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.career-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.match-degree {
  font-size: 24rpx;
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
  padding: 6rpx 15rpx;
  border-radius: 20rpx;
}

.career-info {
  display: flex;
  gap: 30rpx;
  margin-bottom: 15rpx;
}

.salary-range,
.employment-rate {
  font-size: 26rpx;
  color: #666;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.skill-tag {
  font-size: 22rpx;
  color: #764ba2;
  background-color: rgba(118, 75, 162, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.education-info {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 25rpx;
}

.education-text {
  font-size: 28rpx;
  color: #333;
}

.jobs-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.job-tag {
  font-size: 26rpx;
  color: #333;
  background-color: #f8f9fa;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e0e0e0;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.hot-majors {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.major-scroll {
  white-space: nowrap;
  margin-top: 20rpx;
}

.major-card {
  display: inline-block;
  width: 280rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.major-card-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
  white-space: normal;
}

.major-card-salary {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.major-card-rate {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
