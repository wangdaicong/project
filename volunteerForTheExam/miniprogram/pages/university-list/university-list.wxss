.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 120rpx;
  height: 70rpx;
  margin-left: 20rpx;
  background-color: #ff6b35;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
}

/* 筛选条件 */
.filter-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
}

.filter-item .arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #999;
}

/* 统计信息 */
.stats {
  padding: 20rpx;
  background-color: #fff;
  font-size: 24rpx;
  color: #999;
}

/* 院校列表 */
.university-list {
  flex: 1;
  padding: 20rpx;
}

.university-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.university-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.university-info {
  flex: 1;
}

.university-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.tags {
  display: flex;
  margin-bottom: 10rpx;
}

.tag {
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
  font-size: 20rpx;
  border-radius: 4rpx;
  color: #fff;
}

.tag-985 {
  background-color: #ff6b35;
}

.tag-211 {
  background-color: #4ecdc4;
}

.tag-double {
  background-color: #95e1d3;
}

.basic-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.info-item {
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.separator {
  margin: 0 10rpx;
}

.compare-btn {
  width: 100rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ff6b35;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ff6b35;
}

.compare-btn text.active {
  color: #fff;
  background-color: #ff6b35;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* 加载状态 */
.loading, .no-more, .empty {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

/* 对比栏 */
.compare-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.compare-bar text {
  font-size: 28rpx;
  color: #333;
}

.compare-action-btn {
  padding: 10rpx 30rpx;
  background-color: #ff6b35;
  color: #fff;
  font-size: 28rpx;
  border-radius: 30rpx;
}

.clear-btn {
  padding: 10rpx 30rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 30rpx;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.filter-content {
  width: 100%;
  max-height: 70vh;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  max-height: 60vh;
  overflow-y: auto;
}

.filter-option {
  width: 30%;
  margin: 1.5%;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.filter-option.active {
  background-color: #ff6b35;
  color: #fff;
}
