.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.filter-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.filter-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.tier-scroll {
  white-space: nowrap;
}

.tier-btn {
  display: inline-block;
  padding: 15rpx 30rpx;
  background-color: #f8f9fa;
  border-radius: 50rpx;
  margin-right: 15rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tier-btn.active {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #fff;
  font-weight: bold;
}

.cities-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.city-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.city-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.city-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.tier-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.city-stats {
  margin-bottom: 25rpx;
}

.stat-row {
  display: flex;
  align-items: center;
  padding: 15rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.stat-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.hot-industries-section {
  margin-bottom: 20rpx;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.industries-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.industry-tag {
  font-size: 22rpx;
  color: #43e97b;
  background-color: rgba(67, 233, 123, 0.1);
  padding: 8rpx 15rpx;
  border-radius: 8rpx;
}

.compare-checkbox {
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.compare-checkbox label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.compare-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.compare-info {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.compare-btn {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.compare-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 95%;
  max-height: 90%;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  flex-shrink: 0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.close-btn {
  font-size: 40rpx;
  color: #fff;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: scroll;
}

.comparison-table {
  margin-bottom: 40rpx;
}

.table-row {
  display: flex;
  margin-bottom: 15rpx;
}

.table-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  padding: 12rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.label-cell {
  font-weight: bold;
  color: #666;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.value-text {
  font-size: 26rpx;
  font-weight: bold;
}

.chart-section {
  margin-top: 30rpx;
}

.chart-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.compare-bars {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.compare-bar-item {
  margin-bottom: 30rpx;
}

.compare-bar-item:last-child {
  margin-bottom: 0;
}

.city-name-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.bar-group {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 15rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-label {
  width: 60rpx;
  font-size: 24rpx;
  color: #666;
}

.bar-bg {
  flex: 1;
  height: 30rpx;
  background-color: #e0e0e0;
  border-radius: 15rpx;
  overflow: hidden;
  margin: 0 15rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 15rpx;
  transition: width 0.3s;
}

.bar-fill.salary {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.bar-fill.cost {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.bar-value {
  width: 120rpx;
  text-align: right;
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
}
