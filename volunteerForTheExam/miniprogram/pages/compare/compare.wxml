<!--pages/compare/compare.wxml-->
<view class="container">
  <view class="header">
    <text class="title">院校对比</text>
  </view>

  <scroll-view class="compare-table" scroll-x wx:if="{{!loading}}">
    <view class="table">
      <!-- 表头 -->
      <view class="table-row header-row">
        <view class="table-cell label-cell">对比项</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          {{item.name}}
        </view>
      </view>

      <!-- 基本信息 -->
      <view class="table-row">
        <view class="table-cell label-cell">院校层次</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          <text class="tag" wx:if="{{item.is_985}}">985</text>
          <text class="tag" wx:if="{{item.is_211}}">211</text>
          <text class="tag" wx:if="{{item.is_double_first_class}}">双一流</text>
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell label-cell">院校类型</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          {{item.type}}
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell label-cell">所在地区</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          {{item.province}} {{item.city}}
        </view>
      </view>

      <!-- 分数线对比 -->
      <view class="section-title">历年分数线</view>
      
      <view class="table-row">
        <view class="table-cell label-cell">2024年最低分</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          <text wx:if="{{scoreLines[item.id] && scoreLines[item.id][0]}}">
            {{scoreLines[item.id][0].min_score}}
          </text>
          <text wx:else class="no-data">暂无数据</text>
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell label-cell">2024年平均分</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          <text wx:if="{{scoreLines[item.id] && scoreLines[item.id][0]}}">
            {{scoreLines[item.id][0].avg_score}}
          </text>
          <text wx:else class="no-data">暂无数据</text>
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell label-cell">查看趋势</view>
        <view class="table-cell" wx:for="{{universities}}" wx:key="id">
          <button class="trend-btn" bindtap="viewTrend" data-id="{{item.id}}">
            查看
          </button>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
