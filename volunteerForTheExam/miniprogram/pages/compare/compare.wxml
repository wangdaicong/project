<view class="container">
  <view class="header-banner card">
    <view class="banner-title">📊 院校对比</view>
    <view class="banner-desc">多维度对比，科学选择</view>
  </view>

  <view class="compare-list" wx:if="{{compareList.length > 0}}">
    <view class="compare-item card" wx:for="{{compareList}}" wx:key="id">
      <view class="item-header">
        <image class="item-logo" src="{{item.logoUrl || '/images/default-logo.png'}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="item-location">📍 {{item.province}}</view>
        </view>
        <view class="remove-btn" bindtap="removeItem" data-id="{{item.id}}">
          <image class="remove-icon" src="/images/close-icon.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <button class="btn-primary compare-btn" bindtap="startCompare" wx:if="{{compareList.length >= 2}}">
      开始对比 ({{compareList.length}})
    </button>
  </view>

  <view class="empty-state" wx:else>
    <image class="empty-image" src="/images/empty-compare.png" mode="aspectFit"></image>
    <view class="empty-title">暂无对比院校</view>
    <view class="empty-desc">在院校列表中点击对比按钮添加</view>
    <button class="btn-primary" bindtap="goToSearch">去查找院校</button>
  </view>

  <view class="compare-result" wx:if="{{showResult}}">
    <view class="result-section card">
      <view class="section-title">基本信息对比</view>
      <view class="compare-table">
        <view class="table-row">
          <view class="table-label">院校名称</view>
          <view class="table-cell" wx:for="{{compareList}}" wx:key="id">{{item.name}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">所在地区</view>
          <view class="table-cell" wx:for="{{compareList}}" wx:key="id">{{item.province}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">办学层次</view>
          <view class="table-cell" wx:for="{{compareList}}" wx:key="id">{{item.level}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">学校类型</view>
          <view class="table-cell" wx:for="{{compareList}}" wx:key="id">{{item.type}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">全国排名</view>
          <view class="table-cell" wx:for="{{compareList}}" wx:key="id">{{item.ranking}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">录取分数</view>
          <view class="table-cell" wx:for="{{compareList}}" wx:key="id">{{item.minScore}}-{{item.maxScore}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
