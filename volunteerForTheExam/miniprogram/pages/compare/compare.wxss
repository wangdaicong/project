/* pages/compare/compare.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.compare-table {
  white-space: nowrap;
  padding: 20rpx;
}

.table {
  display: inline-block;
  background: #fff;
  border-radius: 15rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #eee;
}

.table-row:last-child {
  border-bottom: none;
}

.header-row {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-row .table-cell {
  color: #fff;
  font-weight: bold;
}

.table-cell {
  min-width: 200rpx;
  padding: 25rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  border-right: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.table-cell:last-child {
  border-right: none;
}

.label-cell {
  min-width: 150rpx;
  background: #f5f5f5;
  font-weight: bold;
  color: #666;
}

.tag {
  padding: 5rpx 10rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 5rpx;
  font-size: 22rpx;
  margin: 0 5rpx;
}

.no-data {
  color: #999;
  font-size: 24rpx;
}

.section-title {
  padding: 30rpx 20rpx 15rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  background: #f5f5f5;
}

.trend-btn {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
