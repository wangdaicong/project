.header-banner {
  background: linear-gradient(135deg, #667EEA 0%, #4A90E2 100%);
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 20rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.compare-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.compare-item {
  position: relative;
}

.item-header {
  display: flex;
  align-items: center;
}

.item-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #F5F7FA;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.item-location {
  font-size: 24rpx;
  color: #7F8C8D;
}

.remove-btn {
  width: 48rpx;
  height: 48rpx;
  background: #FEE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  width: 24rpx;
  height: 24rpx;
}

.compare-btn {
  margin-top: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7F8C8D;
  margin-bottom: 40rpx;
}

.compare-result {
  margin-top: 30rpx;
}

.result-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 20rpx;
}

.compare-table {
  display: flex;
  flex-direction: column;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #E8ECF0;
  min-height: 80rpx;
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.table-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #7F8C8D;
  font-weight: 500;
  padding: 20rpx 0;
  flex-shrink: 0;
}

.table-cell {
  flex: 1;
  font-size: 26rpx;
  color: #2C3E50;
  padding: 20rpx 10rpx;
  text-align: center;
  word-break: break-all;
}
