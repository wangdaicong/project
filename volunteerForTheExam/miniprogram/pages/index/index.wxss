.container {
  padding: 20rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.welcome-card {
  background: linear-gradient(135deg, #667EEA 0%, #4A90E2 100%);
  color: #FFFFFF;
  margin-bottom: 30rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.welcome-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
}

.score-input-box {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 30rpx;
  backdrop-filter: blur(10px);
}

.input-label {
  font-size: 28rpx;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input-row {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.input-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.score-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  padding: 20rpx;
  padding-right: 60rpx;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  position: absolute;
  right: 15rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.province-picker {
  background: #FFFFFF;
  color: #2C3E50;
  padding: 20rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.query-btn {
  width: 100%;
  background: #FFFFFF;
  color: #4A90E2;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 255, 255, 0.3);
}

.score-display {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 30rpx;
  position: relative;
}

.score-item {
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

.score-label {
  opacity: 0.9;
}

.score-value {
  font-weight: 600;
  font-size: 32rpx;
  margin-left: 10rpx;
}

.change-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  opacity: 0.8;
  text-decoration: underline;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #7F8C8D;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin: 30rpx 0 20rpx;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 15rpx;
  padding: 15rpx 20rpx;
  background: linear-gradient(135deg, #F5F7FA 0%, #E8ECF0 100%);
  border-radius: 8rpx;
}

.category-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
}

.category-desc {
  font-size: 22rpx;
  color: #95A5A6;
}

.tool-list {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tool-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.3s;
}

.tool-card:last-child {
  border-bottom: none;
}

.tool-card:active {
  background-color: #f8f9fa;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.tool-content {
  flex: 1;
}

.tool-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #999;
}

.tool-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.feature-cards {
  margin-bottom: 30rpx;
}

.feature-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.feature-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.feature-content {
  flex: 1;
}

.feature-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #95A5A6;
  line-height: 1.4;
}

.feature-arrow {
  font-size: 36rpx;
  color: #BDC3C7;
  margin-left: 10rpx;
}

.university-list {
  margin-bottom: 40rpx;
}

.university-item {
  margin-bottom: 20rpx;
}

.university-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.university-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #F5F7FA;
}

.university-info {
  flex: 1;
}

.university-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 10rpx;
}

.university-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.university-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8ECF0;
}

.meta-item {
  font-size: 24rpx;
  color: #7F8C8D;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.category-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #2C3E50;
  font-weight: 500;
}
